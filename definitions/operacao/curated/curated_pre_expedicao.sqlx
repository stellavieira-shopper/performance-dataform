config {
  type: "table",
  schema: "Ranking_Performance",
  name: "pre_expedicao_raw",
  description: "Pré-expedição raw — Pedidos Mapeados da planilha Google Sheets.",
  bigquery: {
    externalDataConfiguration: {
      sourceFormat: "GOOGLE_SHEETS",
      sourceUris: ["https://docs.google.com/spreadsheets/d/1YqPaDGKeZelm9w0RKZPo1JVVwy9cEyc031kgIxbe6OQ/edit"],
      googleSheetsOptions: { range: "Pedidos Mapeados!A3:E", skipLeadingRows: 1 },
      ignoreUnknownValues: true,
      schema: { fields: [
        { name: "matricula",  type: "INT64" },
        { name: "nome",       type: "STRING" },
        { name: "cage",       type: "STRING" },
        { name: "data_hora",  type: "TIMESTAMP" },
        { name: "data",       type: "DATE" }
      ]}
    }
  }
}

SELECT * FROM ${self()}
